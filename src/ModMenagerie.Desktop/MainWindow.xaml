<Window x:Class="ModMenagerie.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Mod Menagerie" Width="1440" Height="920" MinWidth="1050" MinHeight="700" Background="{DynamicResource Canvas}" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Edge}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Padding" Value="7,5"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinWidth" Value="110"/></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource AccentSidebar}" Padding="18"><DockPanel>
   <StackPanel DockPanel.Dock="Top"><TextBlock Text="THE MOD" Foreground="#C4DACE"/><TextBlock Text="Menagerie" Foreground="White" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="UPGRADE STATUS CENTER" Foreground="#BCD0C6" FontSize="10" Margin="0,5,0,30"/><Button Content="+ New modpack" Click="NewPack" Margin="0,0,0,18"/><TextBlock Text="YOUR MODPACKS" Foreground="#BCD0C6" FontSize="11" Margin="0,0,0,10"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><TextBlock Text="ACCENT COLOR" Foreground="White" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="AccentPicker" AutomationProperties.Name="Accent color" SelectionChanged="ChangeAccent" ToolTip="Choose an accent color" Margin="0,0,0,12"/><TextBlock Text="Metadata tracking only.&#10;Your game files stay yours." Foreground="#BCD0C6" FontSize="12"/></StackPanel>
   <ListBox x:Name="Packs"  SelectionChanged="SelectPack" Background="Transparent" Foreground="White" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="White"/></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel></Border>
  <Grid Grid.Column="1" Margin="22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="ThemeButton" Content="Light mode" Click="ToggleTheme"/><Button Content="Edit modpack" Click="EditPack"/><Button Content="Delete" Click="DeletePack"/></StackPanel><StackPanel><TextBlock x:Name="Heading" Text="Welcome to The Mod Menagerie" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="Context" Text="Create a modpack to plan your next upgrade." Margin="0,6,0,16" FontSize="16"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="8" Padding="18" Margin="0,0,0,14" BorderBrush="{DynamicResource Edge}" BorderThickness="1"><StackPanel><TextBlock x:Name="Summary" Text="No included projects" FontSize="24" FontWeight="SemiBold"/><ProgressBar x:Name="ReadinessBar" Height="7" Margin="0,12" Foreground="{DynamicResource AccentStrong}" Background="{DynamicResource Edge}"/><TextBlock x:Name="Counts" Text="Stable 0 · Beta 0 · Alpha 0" TextWrapping="Wrap"/><TextBlock Text="Beta and alpha count as ready. Overrides and exclusions affect totals. Use Dependencies for a separate dependency-readiness check. Runtime conflicts are not tested." FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
   <StackPanel Grid.Row="2"><WrapPanel Margin="0,0,0,10"><Button x:Name="RefreshButton" Content="Refresh modpack" Click="Refresh" Background="{DynamicResource AccentSurface}"/><Button x:Name="CancelButton" Content="Cancel refresh" Click="CancelRefresh" IsEnabled="False"/><Button Content="+ Add project" Click="AddProject"/><Button Content="Remove selected" Click="RemoveProject"/><Button Content="Columns" Click="Columns"/><Button Content="Import .mrpack" Click="ImportPack"/><Button Content="Dependencies" Click="Dependencies"/><Button Content="History" Click="History"/></WrapPanel><TextBlock x:Name="ProgressText" Text="Saved results are cached. Refresh to check Modrinth." Margin="0,0,0,10" TextWrapping="Wrap"/></StackPanel>
   <StackPanel Grid.Row="3"><WrapPanel Margin="0,0,0,8"><TextBlock Text="Search " VerticalAlignment="Center"/><TextBox x:Name="Search" Width="210" ToolTip="Search tracked projects" AutomationProperties.Name="Search tracked projects" TextChanged="FilterChanged"/><ComboBox x:Name="StatusFilter" SelectionChanged="FilterChanged" ToolTip="Compatibility"/><ComboBox x:Name="TypeFilter" SelectionChanged="FilterChanged" ToolTip="Type"/><CheckBox x:Name="ManualFilter" Content="Manual only" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged" Margin="4,0,12,0"/><Button Content="Clear filters" Click="ClearFilters"/></WrapPanel>
   <Expander Header="More filters" Margin="0,0,0,8"><WrapPanel Margin="0,8"><TextBlock Text="Loader " VerticalAlignment="Center"/><TextBox x:Name="LoaderFilter" Width="120" ToolTip="Supported loader contains" AutomationProperties.Name="Supported loader" TextChanged="FilterChanged"/><TextBlock Text="Category " VerticalAlignment="Center"/><TextBox x:Name="CategoryFilter" Width="130" ToolTip="Category (e.g. library)" AutomationProperties.Name="Category" TextChanged="FilterChanged"/><TextBlock Text="License " VerticalAlignment="Center"/><TextBox x:Name="LicenseFilter" Width="120" ToolTip="License contains" AutomationProperties.Name="License" TextChanged="FilterChanged"/><ComboBox x:Name="LifecycleFilter" SelectionChanged="FilterChanged" ToolTip="Lifecycle"/><ComboBox x:Name="LinkFilter" SelectionChanged="FilterChanged" ToolTip="Has link"/></WrapPanel></Expander></StackPanel>
   <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="320"/><ColumnDefinition Width="8"/><ColumnDefinition Width="350" MinWidth="250"/></Grid.ColumnDefinitions>
    <Grid><DataGrid x:Name="Table" RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource Surface}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="SelectProject" CanUserAddRows="False" CanUserReorderColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Edge}" RowHeight="43" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" Sorting="SortTable" EnableRowVirtualization="True"/><TextBlock x:Name="Empty" Text="Add projects to start tracking this upgrade." HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20" IsHitTestVisible="False"/></Grid>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{DynamicResource Edge}"/>
    <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="6" Padding="16"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"><TextBlock Text="Select a project" FontSize="20" FontWeight="SemiBold"/></StackPanel></ScrollViewer></Border>
   </Grid><TextBlock Grid.Row="5" x:Name="Footer" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
  </Grid>
 </Grid>
</Window>
